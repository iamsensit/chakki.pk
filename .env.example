# Database
MONGODB_URI=mongodb://127.0.0.1:27017/chakki_pk
MONGODB_DB=chakki_pk

# NextAuth Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=chakki-pk-secret-key-32-characters-minimum

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Delivery / COD Settings
COD_FREE_DELIVERY_FIRST_ORDER=true
COD_DEFAULT_DELIVERY_FEE=150
